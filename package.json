{
  "name": "catalyst-create",
  "version": "0.1.0",
  "private": true,
  "description": "Community cape design submissions and voting for Catalyst Client. Every submission is hidden until a human approves it.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:supabase": "node scripts/check-supabase.mjs",
    "check:codes": "node --no-warnings scripts/check-codes.mjs",
    "check:curseforge": "node --no-warnings scripts/check-curseforge.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
