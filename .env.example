# Copy to .env.local and fill in. Nothing here is committed - see .gitignore.

# --- Admin gate (required) -------------------------------------------------
# The shared password for /admin. Anyone with it can approve submissions, so treat it as a
# real credential: long, random, not reused. Changing it signs every admin session out.
ADMIN_PASSWORD=

# --- Supabase (required in production; omit locally to use the dev store) ---
# Project Settings -> Data API -> Project URL
SUPABASE_URL=
# Project Settings -> API Keys -> service_role. SERVER ONLY. It bypasses row-level security,
# so it must never be prefixed NEXT_PUBLIC_ and never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The Storage bucket holding submitted images. Must be PRIVATE.
SUPABASE_BUCKET=submissions

# --- CurseForge relay for the launcher's mod browser (optional) -------------
# From the CurseForge for Studios console (https://console.curseforge.com). SERVER ONLY: this is the
# whole reason the launcher talks to CurseForge through this site. Leave empty and the launcher shows
# Modrinth only; /api/mods/curseforge/* answer 503 "not_configured".
CURSEFORGE_API_KEY=
